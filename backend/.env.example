# Copy to .env and fill in. Never commit .env.
# development locally; production on Render (requires API_KEY, hides /docs).
ENVIRONMENT=development

# Shared secret with the frontend's BACKEND_API_KEY. Empty = no check (fine locally).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated list of browser origins allowed to call the API directly.
# (The Next.js proxy calls server-to-server, so this mainly matters for local tools.)
CORS_ORIGINS=http://localhost:3000

# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: a separate (cheaper) model for the agent's planner, e.g. openai/gpt-oss-20b.
# Leave empty to use GROQ_MODEL. Groq limits are per model, so this saves quota on the main model.
GROQ_PLANNER_MODEL=openai/gpt-oss-20b
# gpt-oss "thinking" effort: low | medium | high (low = faster, fewer tokens). Ignored for other models.
GROQ_REASONING_EFFORT=low
# Thinking effort for the agent planner (choosing tools). medium = more reliable tool calls.
GROQ_PLANNER_REASONING_EFFORT=medium
# How many times to re-ask the LLM when its JSON fails validation
LLM_MAX_RETRIES=2
# Safety cap on tool calls per agent run
AGENT_MAX_STEPS=12

# Local: a SQLite file next to the backend.
# Production: a Postgres URL (Neon, Render Postgres...). postgres:// URLs are converted automatically.
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Docker Compose uses sqlite:////data/hiremate.db on a named volume.
DATABASE_URL=sqlite:///./hiremate.db
# Demo profile for screenshots/presentations only. When false, any old demo profile is removed on startup.
SEED_DEMO_DATA=false

# Uploads (use 4 when the frontend is on Vercel: it rejects request bodies over 4.5 MB)
MAX_UPLOAD_MB=5
UPLOAD_RATE_LIMIT_PER_MINUTE=5
ANALYSIS_RATE_LIMIT_PER_MINUTE=10
