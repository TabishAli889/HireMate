# Server-side only: where the Next.js proxy (/api/backend/*) forwards requests.
# Never prefix with NEXT_PUBLIC_ — the browser should never see this URL.
BACKEND_URL=http://localhost:8000

# Must match the backend's API_KEY (leave both empty locally).
BACKEND_API_KEY=

# Optional password for the whole site (browser login prompt). Set both on Vercel; leave empty locally.
SITE_USERNAME=
SITE_PASSWORD=

# Largest resume PDF the browser will send. Use 4 on Vercel (its limit is 4.5 MB per request).
NEXT_PUBLIC_MAX_UPLOAD_MB=5
